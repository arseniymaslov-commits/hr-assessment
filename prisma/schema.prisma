generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  LEADER
  DASHBOARD_VIEWER
  DIRECTOR
  VIEWER
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Department {
  id                         String                  @id @default(cuid())
  name                       String                  @unique
  shortName                  String                  @default("")
  responsibleName            String?
  responsibleEmail           String?
  leaderUserId               String?
  deputyUserId               String?
  isActive                   Boolean                 @default(true)
  createdAt                  DateTime                @default(now())
  leaders                    User[]
  leaderUser                 User?                   @relation("DepartmentLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  deputyUser                 User?                   @relation("DepartmentDeputy", fields: [deputyUserId], references: [id], onDelete: SetNull)
  directorAssignments        DepartmentDirector[]
  givenEvaluations           Evaluation[]            @relation("EvaluatorDepartment")
  receivedEvaluations        Evaluation[]            @relation("EvaluateeDepartment")
  requiredGivenEvaluations   EvaluationRequirement[] @relation("RequiredEvaluatorDepartment")
  requiredReceivedEvaluations EvaluationRequirement[] @relation("RequiredEvaluateeDepartment")
  evaluationRequests         EvaluationRequest[]
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  passwordHash  String?
  mustChangePassword Boolean @default(true)
  role          Role        @default(LEADER)
  position      String?
  isActive      Boolean     @default(true)
  receivesNotifications Boolean @default(true)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  evaluations   Evaluation[] @relation("EvaluationAuthor")
  directedEvaluations Evaluation[] @relation("EvaluationDirector")
  initiatedRequests EvaluationRequest[] @relation("EvaluationRequestInitiator")
  leadingDepartments Department[] @relation("DepartmentLeader")
  deputyDepartments Department[] @relation("DepartmentDeputy")
  directorDepartments DepartmentDirector[]
}

model DepartmentDirector {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([departmentId, userId])
  @@index([departmentId])
  @@index([userId])
}

model Period {
  id          String       @id @default(cuid())
  month       Int
  year        Int
  status      PeriodStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  evaluations Evaluation[]
  requests    EvaluationRequest[]

  @@unique([month, year])
}

model Criterion {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  weight      Int          @default(1)
  isActive    Boolean      @default(true)
  evaluations Evaluation[]
}

model Evaluation {
  id                    String     @id @default(cuid())
  periodId              String
  period                Period     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  evaluatorDepartmentId String?
  evaluatorDepartment   Department? @relation("EvaluatorDepartment", fields: [evaluatorDepartmentId], references: [id], onDelete: Cascade)
  evaluatorUserId       String?
  evaluatorUser         User?      @relation("EvaluationDirector", fields: [evaluatorUserId], references: [id], onDelete: Cascade)
  evaluateeDepartmentId String
  evaluateeDepartment   Department @relation("EvaluateeDepartment", fields: [evaluateeDepartmentId], references: [id], onDelete: Cascade)
  criterionId           String
  criterion             Criterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  score                 Int?
  noInteraction         Boolean    @default(false)
  deviationCategories   String[]   @default([])
  comment               String?
  authorId              String
  author                User       @relation("EvaluationAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@unique([periodId, evaluatorDepartmentId, evaluateeDepartmentId, criterionId])
  @@index([periodId, evaluateeDepartmentId])
  @@index([periodId, evaluatorDepartmentId])
  @@index([periodId, evaluatorUserId])
  @@index([criterionId, periodId])
  @@index([criterionId, noInteraction, score])
}

model EvaluationRequirement {
  id                    String     @id @default(cuid())
  evaluatorDepartmentId String
  evaluatorDepartment   Department @relation("RequiredEvaluatorDepartment", fields: [evaluatorDepartmentId], references: [id], onDelete: Cascade)
  evaluateeDepartmentId String
  evaluateeDepartment   Department @relation("RequiredEvaluateeDepartment", fields: [evaluateeDepartmentId], references: [id], onDelete: Cascade)
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@unique([evaluatorDepartmentId, evaluateeDepartmentId])
  @@index([evaluatorDepartmentId])
  @@index([evaluateeDepartmentId])
}

model EvaluationRequest {
  id                    String       @id @default(cuid())
  periodId              String
  period                Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  evaluateeDepartmentId String
  evaluateeDepartment   Department   @relation(fields: [evaluateeDepartmentId], references: [id], onDelete: Cascade)
  initiatedById         String
  initiatedBy           User         @relation("EvaluationRequestInitiator", fields: [initiatedById], references: [id], onDelete: Cascade)
  scheduledAt           DateTime     @default(now())
  notificationSentAt    DateTime?
  createdAt             DateTime     @default(now())

  @@unique([periodId, evaluateeDepartmentId])
  @@index([scheduledAt, notificationSentAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  summary   String
  details   String?
  userId    String?
  userName  String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model EmailDelivery {
  id          String              @id @default(cuid())
  to          String
  subject     String
  status      EmailDeliveryStatus @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?
  context     String?
  periodId    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  sentAt      DateTime?

  @@index([status])
  @@index([periodId])
  @@index([createdAt])
}
